#!/usr/bin/env python3
"""Pre-commit hook - quality gate para ia-bloque-b-busqueda"""
import subprocess, sys, os

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HTML_PATH = os.path.join(REPO_ROOT, "presentacion", "ia_bloque_b.html")

def run_check(script_name, html_path):
    script = os.path.join(REPO_ROOT, script_name)
    if not os.path.exists(script):
        print(f"  SKIP: {script_name} no encontrado")
        return True
    result = subprocess.run([sys.executable, script, html_path], capture_output=True, text=True)
    print(result.stdout)
    if result.stderr: print(result.stderr)
    return result.returncode == 0

def main():
    print("=" * 60)
    print("PRE-COMMIT HOOK: Bloque B - Busqueda sin Informacion")
    print("=" * 60)
    if not os.path.exists(HTML_PATH):
        print(f"WARN: {HTML_PATH} no encontrado, saltando")
        sys.exit(0)
    eval_ok = run_check("eval_quiz.py", HTML_PATH)
    guard_ok = run_check("guardrails.py", HTML_PATH)
    if not eval_ok or not guard_ok:
        print("\nCOMMIT BLOQUEADO: validaciones fallaron.")
        sys.exit(1)
    print("\nValidaciones OK. Commit permitido.")
    sys.exit(0)

if __name__ == "__main__":
    main()
